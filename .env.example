# Copy to .env. The server reads it when it starts, and docker compose passes
# it on.

# Profiles an account may hold. The app reads it from the server.
SC_MAX_PROFILES=10

# How the server takes new accounts: invite (a code from `invite`), open, or
# closed.
SC_SIGNUP=invite

# The first superuser, made on the first start. Take the password out of this
# file once it exists.
# SC_ADMIN_EMAIL=you@example.com
# SC_ADMIN_PASSWORD=

# Behind a reverse proxy only: the header it puts the caller's address in. Never
# without a proxy — anyone could send it, and claim any address.
# SC_TRUST_PROXY=X-Forwarded-For

# The host port docker compose publishes: 8090, or 127.0.0.1:8090 behind a
# reverse proxy on the same machine.
# SC_PUBLISH=8090
