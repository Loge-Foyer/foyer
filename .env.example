# Copy to .env. docker compose reads it, and so does npm start.

# Where the server listens. In the container these stay as they are; publish
# another port with SC_SYNC_PUBLISH instead.
SC_SYNC_PORT=8730
SC_SYNC_HOST=0.0.0.0

# Where the database lives, for npm start. The image keeps it in /data.
# SC_SYNC_DATA=./data

# The host port docker compose publishes: 8730, or 127.0.0.1:8730 behind a
# reverse proxy on the same machine.
# SC_SYNC_PUBLISH=8730

# Behind a reverse proxy, 1: a caller's address — what throttling counts by —
# is then the hop the proxy appended to X-Forwarded-For. Never set it without
# a proxy, or anyone could claim any address.
SC_SYNC_TRUST_PROXY=0
