{
  "name": "@sc/sync-server",
  "version": "0.1.0",
  "private": true,
  "description": "The Streaming Center sync server: one account's log, for the devices of one household.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node scripts/build.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/main.mjs",
    "sc-sync": "node --disable-warning=ExperimentalWarning dist/cli.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@types/node": "^24",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
